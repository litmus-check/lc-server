# =============================================================================
# Litmus Check — backend configuration (src/)
#
# Copy this file to `app.env` in the repo root and fill in real values.
# `app.env` is git-ignored and loaded via python-dotenv (find_dotenv('app.env')).
# NEVER commit real secrets — only this .example file, with placeholders.
#
# Keys are grouped as [required] or [optional]. Optional keys either have a
# code default (shown) or gate a feature you may not use.
#
# NOTE: The LitmusAgent (TypeScript) and GatewayService read their own
# env files (LitmusAgent/.env, GatewayService/.env), NOT this one.
# =============================================================================

# --- Core --------------------------------------------------------------------
ENVIRONMENT=local                       # [optional] local | uat | prod (default: local)

# PostgreSQL [required]
DB_NAME=litmus
DB_USER=litmus
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis — shared run state, Celery broker, RedBeat store [required]
REDIS_URL=redis://localhost:6379/0

# Secret encryption for stored credentials/variables [required — no defaults]
# The app raises on startup if these are unset. Use long random strings.
ENCRYPTION_SALT=change-me-to-a-random-salt
ENCRYPTION_PASSWORD=change-me-to-a-random-password

# Authentication (JWT) [required]
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_EXPIRY_HOURS=24                     # [optional] default: 24
DEFAULT_ORG_ID=default-org              # [optional] default: default-org
DEFAULT_USER_ROLE=USER                  # [optional] default: USER

# --- Azure OpenAI (backend triage / test-plan generation) --------------------
# [required] for AI triage / test-plan features
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_MODEL_NAME=your-model-name
AZURE_OPENAI_MODEL=gpt-5.5              # [optional] default: gpt-5.5

# --- Azure Storage (trace / GIF / report artifacts) --------------------------
# [required] for artifact upload
STORAGE_ACCOUNT_NAME=yourstorageaccount
STORAGE_ACCOUNT_KEY=your-storage-account-key
CONTAINER_NAME=your-blob-container

# --- Test execution ----------------------------------------------------------
RUN_TEST_HEADLESS=True                  # [optional] default: True
BASE_URL=http://localhost:3000          # [optional] base URL for dashboard links in notifications

# --- Test runner backend -----------------------------------------------------
# Docker runner [required if running tests via local Docker]
DOCKER_LOGS_DIR=/var/log/litmus

# Kubernetes runner [optional — only if using the AKS/K8s runner]
KUBERNETES_NAMESPACE=test-runners       # [optional] default: test-runners
# KUBECONFIG=/path/to/kubeconfig
# AZURE_CONTAINER_REGISTRY_URL=your-registry.example.com/
# AZURE_PVC_NAME=azurefile-pvc          # [optional] default: azurefile-pvc
# LOGS_VOLUME_NAME=logs-volume          # [optional] default: logs-volume

# Browserbase [optional — remote browser provider, alternative to local/Docker Chromium]
# BROWSERBASE_PROJECT_ID=your-project-id
# BROWSERBASE_API_KEY=your-browserbase-api-key

# --- Notifications (all optional) --------------------------------------------
# Email (Brevo)
# BREVO_API_KEY=your-brevo-api-key
# SENDER_EMAIL=noreply@example.com
# SENDER_NAME=Litmus Check
# BCC_EMAILS=ops@example.com,qa@example.com   # comma-separated; empty = no BCC
# EMAIL_WHITELISTED_DOMAINS=example.com       # comma-separated; empty = allow all (non-prod)
# EMAIL_LOGO_URL=https://example.com/logo.png # empty = no logo in emails

# Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Monitoring (optional) ---------------------------------------------------
# SENTRY_URL=https://your-dsn@sentry.io/project-id   # empty = Sentry disabled
# SENTRY_ENV=local

# --- Logging (optional) ------------------------------------------------------
# LOG_FILE_NAME=app.log                 # empty = console logging only
# CELERY_PROCESS=1                       # set inside the Celery worker process
