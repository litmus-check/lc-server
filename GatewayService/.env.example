# =============================================================================
# Litmus Check — GatewayService configuration (GatewayService/)
#
# Copy this file to `GatewayService/.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real secrets — only this .example.
#
# The gateway runs inside Kubernetes and loads cluster config from its
# in-cluster service account. It listens on port 8080 (hardcoded).
# =============================================================================

# Kubernetes namespace to search for agent pods (by the `run_id` label) [required]
NAMESPACE=test-runners

# Endpoint that validates the client's Bearer token.
# The gateway sends `Authorization: Bearer <token>` and treats HTTP 200 as valid. [required]
AUTH_API_URL=https://your-api.example.com/v1/user
