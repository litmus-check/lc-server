# =============================================================================
# Litmus Check — LitmusAgent configuration (LitmusAgent/)
#
# Copy this file to `LitmusAgent/.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real secrets — only this .example.
#
# Used both when running the agent directly and via docker-compose (env_file: .env).
# =============================================================================

# --- Redis -------------------------------------------------------------------
# Shared session state with the backend (keyed by run_id) [required]
REDIS_URL=redis://localhost:6379/0

# --- Azure OpenAI (browser action & goal reasoning) --------------------------
# [required]
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_MODEL_NAME=your-model-name
AZURE_OPENAI_INSTANCE_NAME=your-resource   # Azure resource/instance name

# --- Azure Storage (trace / GIF / screenshot artifacts) ----------------------
# [required]
STORAGE_ACCOUNT_NAME=yourstorageaccount
STORAGE_ACCOUNT_KEY=your-storage-account-key
CONTAINER_NAME=your-blob-container

# --- WebSocket screencast server ---------------------------------------------
WS_PORT=8080                            # [optional] default: 8080
# WS_HOST=0.0.0.0                       # [optional] host the screencast client connects to

# --- Email verification (verify_email goal steps) ----------------------------
# [optional] IMAP inbox used to read sign-up verification codes/links
# GMAIL_ACCOUNT=your-account@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Runtime / logging (optional) --------------------------------------------
# NODE_ENV=production
# DOCKER_ENV=true                       # set when running inside a container
# IN_DOCKER=true
# FORCE_PLAIN_LOGS=true                 # disable structured logs
# AGENT_TYPE=...                        # injected automatically by the backend; do not set manually

# --- Browserbase (agent test suite only) -------------------------------------
# [optional] only needed to run the agent's Jest tests against Browserbase
# BROWSERBASE_API_KEY=your-browserbase-api-key
# BROWSERBASE_PROJECT_ID=your-project-id

# NOTE: docker-compose.yml also passes OPENAI_API_KEY, but the agent's LLM
# calls use the AZURE_OPENAI_* variables above.
